<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      netstandard2.0 is a standard, not a runtime, so it cannot be a test project's target framework.
      This project runs on net6.0 but pins the reference to the library's netstandard2.0 asset, so the
      assembly actually loaded is the one netstandard2.0 consumers get: unsafe kernels instead of SIMD,
      no Span overloads, no batch API. AssemblyIsNetStandardBuild asserts that at runtime.
    -->
    <ProjectReference Include="..\FastDtw.CSharp\FastDtw.CSharp.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Data\Test.csv">
      <Link>Test.csv</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
